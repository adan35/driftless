<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.driftless</groupId>
		<artifactId>driftless-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>app</artifactId>
	<name>app</name>
	<description>Spring Boot bootstrap: wires every feature module and exposes the REST API.
		The runnable modular-monolith boot jar.</description>

	<dependencies>
		<!-- app is the only module that depends on all features; this encodes the monolith wiring. -->
		<dependency>
			<groupId>io.driftless</groupId>
			<artifactId>common</artifactId>
		</dependency>
		<dependency>
			<groupId>io.driftless</groupId>
			<artifactId>ledger</artifactId>
		</dependency>
		<dependency>
			<groupId>io.driftless</groupId>
			<artifactId>idempotency</artifactId>
		</dependency>
		<dependency>
			<groupId>io.driftless</groupId>
			<artifactId>auth</artifactId>
		</dependency>
		<dependency>
			<groupId>io.driftless</groupId>
			<artifactId>rules</artifactId>
		</dependency>
		<dependency>
			<groupId>io.driftless</groupId>
			<artifactId>tokens</artifactId>
		</dependency>
		<dependency>
			<groupId>io.driftless</groupId>
			<artifactId>recon</artifactId>
		</dependency>
		<dependency>
			<groupId>io.driftless</groupId>
			<artifactId>observability</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
		    Browsable API contract. springdoc-openapi 2.x targets Spring 6 / Spring Boot 3 and is not
		    yet compatible with this project's Spring Boot 4 runtime (it would break the build), so the
		    contract is the hand-authored, committed deploy/openapi/openapi.yaml served statically at
		    /openapi.yaml (copied below) and rendered by Swagger UI at /swagger-ui/index.html. The
		    swagger-ui webjar provides the UI assets under /webjars/** — static files only, no runtime
		    framework coupling.
		-->
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>swagger-ui</artifactId>
			<version>5.32.13</version>
		</dependency>

		<!-- Spec 08: actuator + Prometheus registry expose /actuator/prometheus and /actuator/health,
		     and auto-provide JVM / HTTP / Hikari metrics alongside the custom driftless_* meters. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		    ArchUnit imports every io.driftless main class on app's classpath (app depends on all
		    feature modules) and proves the module-boundary contract in CI: no module reaches into
		    another's internal/web packages, the dependency direction points inward, and there are no
		    package cycles. Test scope only; tests are excluded from the import, so recon/observability
		    test fixtures that legitimately touch internals do not register as violations.
		-->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		    Since Spec 01 the ledger module brings JPA + Flyway, so the monolith context requires a
		    real datasource to boot. The smoke test stands one up via Testcontainers Postgres, which
		    is how the modular monolith is actually run. Test-scope only; no production change.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			    Single-source the API contract: copy the committed deploy/openapi/openapi.yaml onto the
			    classpath as a static resource so the booted app serves it at GET /openapi.yaml (and
			    Swagger UI at /swagger-ui/index.html renders it) without duplicating the file in-repo.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-openapi-contract</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/../deploy/openapi</directory>
									<includes>
										<include>openapi.yaml</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Only app and partner-simulator repackage into runnable boot jars. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
