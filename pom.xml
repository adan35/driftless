<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>

	<groupId>io.driftless</groupId>
	<artifactId>driftless-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>driftless-parent</name>
	<description>Driftless — issuer-processor core: immutable double-entry ledger + card-auth saga</description>

	<modules>
		<module>common</module>
		<module>ledger</module>
		<module>idempotency</module>
		<module>auth</module>
		<module>rules</module>
		<module>tokens</module>
		<module>recon</module>
		<module>observability</module>
		<module>app</module>
		<module>partner-simulator</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Plugin versions -->
		<spotless.version>2.43.0</spotless.version>
		<jacoco.version>0.8.12</jacoco.version>
		<palantir-java-format.version>2.50.0</palantir-java-format.version>

		<!-- Dependency versions not managed by the Spring Boot BOM -->
		<jqwik.version>1.9.1</jqwik.version>

		<!-- common minimum line coverage; raised per-module where logic exists -->
		<coverage.line.min>0.00</coverage.line.min>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Internal modules: single source of versions for the reactor -->
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>ledger</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>idempotency</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>auth</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>rules</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>tokens</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>recon</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>observability</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- jqwik property-based testing engine (not in the Spring Boot BOM) -->
			<dependency>
				<groupId>net.jqwik</groupId>
				<artifactId>jqwik</artifactId>
				<version>${jqwik.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Lombok annotation processing inherited by every module -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>

				<!-- Format gate: palantir-java-format, applied repo-wide and checked on verify -->
				<plugin>
					<groupId>com.diffplug.spotless</groupId>
					<artifactId>spotless-maven-plugin</artifactId>
					<version>${spotless.version}</version>
					<configuration>
						<java>
							<palantirJavaFormat>
								<version>${palantir-java-format.version}</version>
							</palantirJavaFormat>
							<removeUnusedImports/>
							<importOrder/>
							<trimTrailingWhitespace/>
							<endWithNewline/>
						</java>
					</configuration>
					<executions>
						<execution>
							<id>spotless-check</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- Coverage report on every module; enforcement is opt-in per module -->
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
					<executions>
						<execution>
							<id>jacoco-prepare</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<execution>
							<id>jacoco-report</id>
							<phase>verify</phase>
							<goals>
								<goal>report</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!-- Spotless and JaCoCo run in every module; thresholds added where logic exists -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
