<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>io.driftless</groupId>
	<artifactId>driftless-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>driftless-parent</name>
	<description>Driftless — issuer-processor core: immutable double-entry ledger + card-auth saga</description>

	<modules>
		<module>common</module>
		<module>ledger</module>
		<module>idempotency</module>
		<module>auth</module>
		<module>rules</module>
		<module>tokens</module>
		<module>recon</module>
		<module>observability</module>
		<module>app</module>
		<module>partner-simulator</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Plugin versions -->
		<spotless.version>3.8.0</spotless.version>
		<jacoco.version>0.8.15</jacoco.version>
		<palantir-java-format.version>2.50.0</palantir-java-format.version>
		<maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
		<cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>

		<!-- Build-contract floors enforced by maven-enforcer at the validate phase -->
		<enforcer.java.version>[21,)</enforcer.java.version>
		<enforcer.maven.version>[3.9.0,)</enforcer.maven.version>

		<!-- Dependency versions not managed by the Spring Boot BOM -->
		<jqwik.version>1.10.1</jqwik.version>
		<archunit.version>1.4.2</archunit.version>

		<!-- common minimum line coverage; raised per-module where logic exists -->
		<coverage.line.min>0.00</coverage.line.min>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Internal modules: single source of versions for the reactor -->
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>ledger</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>idempotency</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>auth</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>rules</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>tokens</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>recon</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.driftless</groupId>
				<artifactId>observability</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- jqwik property-based testing engine (not in the Spring Boot BOM) -->
			<dependency>
				<groupId>net.jqwik</groupId>
				<artifactId>jqwik</artifactId>
				<version>${jqwik.version}</version>
				<scope>test</scope>
			</dependency>

			<!-- ArchUnit: proves module boundaries in CI (not in the Spring Boot BOM) -->
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!--
				    The site lifecycle is never run, but its default binding (maven-site-plugin) arrives
				    unversioned via Maven core defaults, which trips enforcer's requirePluginVersions.
				    Pinning the version here makes every plugin in the build explicitly versioned with no
				    floating defaults; it adds no behaviour since `site` is not part of verify.
				-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-site-plugin</artifactId>
					<version>3.22.0</version>
				</plugin>

				<!-- Lombok annotation processing inherited by every module -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>

				<!-- Format gate: palantir-java-format, applied repo-wide and checked on verify -->
				<plugin>
					<groupId>com.diffplug.spotless</groupId>
					<artifactId>spotless-maven-plugin</artifactId>
					<version>${spotless.version}</version>
					<configuration>
						<java>
							<palantirJavaFormat>
								<version>${palantir-java-format.version}</version>
							</palantirJavaFormat>
							<removeUnusedImports/>
							<importOrder/>
							<trimTrailingWhitespace/>
							<endWithNewline/>
						</java>
					</configuration>
					<executions>
						<execution>
							<id>spotless-check</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- Coverage report on every module; enforcement is opt-in per module -->
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
					<executions>
						<execution>
							<id>jacoco-prepare</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<execution>
							<id>jacoco-report</id>
							<phase>verify</phase>
							<goals>
								<goal>report</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!-- Spotless and JaCoCo run in every module; thresholds added where logic exists -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>

			<!--
			    Build-contract gate: lock Java/Maven floors and the reactor's coherence at `validate`,
			    so a drift in toolchain or coordinates fails fast before anything compiles. Runs in
			    every module (cheap, no network). dependencyConvergence is deliberately NOT enabled:
			    the Spring Boot BOM legitimately resolves transitive diamonds that do not converge
			    without exclusions, so requiring it would be a perpetually red gate, not a real signal.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer-plugin.version}</version>
				<executions>
					<execution>
						<id>enforce-build-contract</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>${enforcer.java.version}</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>${enforcer.maven.version}</version>
								</requireMavenVersion>
								<banDuplicatePomDependencyVersions/>
								<reactorModuleConvergence/>
								<requirePluginVersions>
									<banLatest>true</banLatest>
									<banRelease>true</banRelease>
									<banSnapshots>true</banSnapshots>
								</requirePluginVersions>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
			    Supply-chain provenance: emit a CycloneDX SBOM for the whole reactor. makeAggregateBom is
			    an aggregator goal, so it runs once at the root after every module is packaged and writes
			    target/bom.json + target/bom.xml. inherited=false keeps child modules from each emitting a
			    partial BOM; the aggregate is the artifact CI uploads.
			-->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
				<version>${cyclonedx-maven-plugin.version}</version>
				<inherited>false</inherited>
				<executions>
					<execution>
						<id>cyclonedx-aggregate-bom</id>
						<phase>package</phase>
						<goals>
							<goal>makeAggregateBom</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<outputFormat>all</outputFormat>
					<outputName>bom</outputName>
					<projectType>application</projectType>
					<schemaVersion>1.5</schemaVersion>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
