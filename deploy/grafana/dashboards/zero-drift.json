{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 0,
  "title": "Driftless — Zero Drift",
  "uid": "driftless-zero-drift",
  "tags": ["driftless", "zero-drift", "public"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Reconciliation drift (minor units) — must be $0",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "$0 — ZERO DRIFT", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
          "expr": "max(driftless_recon_drift_amount)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest reconciliation outcome",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FAILED", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "PASSED", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
          "expr": "min(driftless_recon_run_passed)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reconciliation pass/fail over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
          "expr": "min(driftless_recon_run_passed)",
          "legendFormat": "passed (1=pass)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Compensating reversals (rises under fault injection; drift stays 0)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
          "expr": "sum(rate(driftless_auth_compensating_reversals_total[5m]))",
          "legendFormat": "compensating reversals/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox health — pending depth & stuck events",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
          "expr": "max(driftless_outbox_pending_depth)",
          "legendFormat": "pending depth"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
          "expr": "max(driftless_recon_stuck_outbox_count)",
          "legendFormat": "stuck (reconciliation)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ledger signed-sum witness (|Σ| minor units; must be 0)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "driftless-prometheus" },
          "expr": "max(driftless_ledger_signed_sum_abs_minor)",
          "legendFormat": "abs signed sum"
        }
      ]
    }
  ]
}
